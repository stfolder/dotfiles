  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#81799C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation markup",
      "scope": [
        "comment.block.documentation storage.type.class",
        "comment.block.documentation storage.type.annotation",
        "comment.block.documentation entity.name.type"
      ],
      "settings": {
        "foreground": "#A9A0FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9ECE8A"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "meta.template.expression",
        "meta.interpolation",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#DAD6EB"
      }
    },
    {
      "name": "Numbers and language constants",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#E7BD78"
      }
    },
    {
      "name": "Constants and enum members",
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.other.enummember",
        "support.constant"
      ],
      "settings": {
        "foreground": "#EF9F76"
      }
    },
    {
      "name": "Keywords and control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E6A6D7"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#AAA3BF"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "variable.function",
        "support.function",
        "support.function.builtin",
        "entity.name.operator.custom-literal"
      ],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "Types, classes, and interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.struct",
        "support.type",
        "support.class",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#A9A0FF"
      }
    },
    {
      "name": "Namespaces, modules, and packages",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "support.module",
        "support.other.module",
        "variable.language.import"
      ],
      "settings": {
        "foreground": "#7DCFFF"
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.parameter",
        "meta.function.parameters"
      ],
      "settings": {
        "foreground": "#DAD6EB"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#7DCFFF"
      }
    },
    {
      "name": "Language variables and self references",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#B69CFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.annotation",
        "punctuation.definition.annotation",
        "entity.name.function.decorator",
        "meta.decorator",
        "entity.name.tag.decorator"
      ],
      "settings": {
        "foreground": "#B69CFF"
      }
    },
    {
      "name": "HTML and XML tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "HTML, XML, and JSX attributes",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name.css",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "#A9A0FF"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "JSON and YAML keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.yaml",
        "entity.name.tag.yaml",
        "string.unquoted.plain.out.yaml"
      ],
      "settings": {
        "foreground": "#7DCFFF"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.regexp",
        "keyword.control.anchor.regexp"
      ],
      "settings": {
        "foreground": "#74D3C4"
      }
    },
    {
      "name": "Paths, links, and escapes",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "constant.character.escape",
        "punctuation.definition.link"
      ],
      "settings": {
        "foreground": "#7DCFFF"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#A9A0FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic",
        "markup.italic.markdown"
      ],
      "settings": {
        "foreground": "#DAD6EB",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold",
        "markup.bold.markdown"
      ],
      "settings": {
        "foreground": "#DAD6EB",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#9ECE8A"
      }
    },
    {
      "name": "Inserted content",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#9ECE8A"
      }
    },
    {
      "name": "Changed content",
      "scope": [
        "markup.changed",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#E7BD78"
      }
    },
    {
      "name": "Deleted content",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#F2778F"
      }
    },
    {
      "name": "Invalid and deprecated",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#F2778F",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#7DCFFF",
